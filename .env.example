# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
# Imagem do ARTEX. O default vem de docker-compose.override.yml (digest auditado).
# Para usar uma build local: ARTEX_REF=artex:local
# NUNCA use tomicdd/artex: a imagem prebuilt foi comprometida com backdoor de
# execução não autenticada em nov/2026 (ver HARDENING.md).
# ARTEX_REF=ruoji6/artex@sha256:b4848e321d5599f5a5d8de7a28e7e31b694db4281e5f4548d1aa09df59c44e14
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# HTTP User-Agent；留空时从浏览器 UA 样本中随机抽选，填写则使用固定值
ARTEX_HTTP_USER_AGENT=
